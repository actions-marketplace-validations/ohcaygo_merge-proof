{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:merge-proof:github-receipt:2",
  "title": "Merge Proof immutable GitHub receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "policy",
    "verdict",
    "issuedAt",
    "identity",
    "fingerprint",
    "summary",
    "gaps",
    "local",
    "evidence",
    "notChecked",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "receiptId": { "type": "string", "format": "uuid" },
    "policy": { "const": "github-exact-state-v1" },
    "verdict": { "enum": ["VERIFIED", "NOT_PROVEN", "FAIL"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "object",
      "required": [
        "repository",
        "repositoryId",
        "visibility",
        "authorization",
        "pr",
        "headSha",
        "headRef",
        "baseRef",
        "baseSha"
      ],
      "properties": {
        "repository": { "type": "string" },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "visibility": { "enum": ["public", "private"] },
        "authorization": { "enum": ["PUBLIC_ANONYMOUS", "GITHUB_TOKEN"] },
        "pr": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/sha" },
        "baseSha": { "$ref": "#/$defs/sha" },
        "headRef": { "type": "string" },
        "baseRef": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["ci", "approval", "remote", "rules", "target"]
    },
    "local": {
      "type": "object",
      "required": ["verdict", "findings", "metrics"]
    },
    "evidence": {
      "type": "object",
      "required": [
        "identity",
        "git",
        "rules",
        "target",
        "checks",
        "statuses",
        "execution",
        "reviews",
        "remote",
        "source",
        "observedAt",
        "consistency"
      ],
      "properties": {
        "git": { "$ref": "#/$defs/observation" },
        "target": { "$ref": "#/$defs/observation" },
        "checks": { "$ref": "#/$defs/observation" },
        "statuses": { "$ref": "#/$defs/observation" },
        "execution": { "$ref": "#/$defs/observation" },
        "reviews": { "$ref": "#/$defs/observation" },
        "remote": { "$ref": "#/$defs/observation" },
        "rules": {
          "type": "object",
          "required": ["classic", "active"],
          "properties": {
            "classic": { "$ref": "#/$defs/observation" },
            "active": { "$ref": "#/$defs/observation" }
          }
        },
        "consistency": {
          "enum": ["STABLE_OBSERVATION", "CHANGED_DURING_COLLECTION"]
        },
        "source": { "const": "github-rest" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "notChecked": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "value"],
          "properties": { "state": { "const": "AVAILABLE" } }
        },
        {
          "type": "object",
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "UNAVAILABLE" },
            "reason": { "type": "string" }
          }
        }
      ]
    }
  }
}
