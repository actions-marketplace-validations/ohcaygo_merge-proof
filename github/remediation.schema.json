{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:merge-proof:remediation:1",
  "title": "Derived NOT_PROVEN remediation view; not immutable proof evidence",
  "type": ["object", "null"],
  "required": ["version", "summary", "mergeConsequence", "items"],
  "properties": {
    "version": { "const": 1 },
    "summary": { "type": "string" },
    "mergeConsequence": { "$ref": "#/$defs/consequence" },
    "items": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["reasonCode", "summary", "whatHappened", "whyItMatters", "nextAction", "automaticRecheck", "mergeConsequence", "policyBlocksGap"],
      "properties": {
        "reasonCode": { "type": "string" },
        "summary": { "type": "string" },
        "whatHappened": { "type": "string" },
        "whyItMatters": { "type": "string" },
        "nextAction": { "type": "string" },
        "policyBlocksGap": { "type": ["boolean", "null"] },
        "mergeConsequence": { "$ref": "#/$defs/consequence" },
        "automaticRecheck": { "type": "object", "required": ["state", "events", "text"], "properties": {
          "state": { "enum": ["EVENT_DRIVEN", "NO_KNOWN_TRIGGER"] },
          "events": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string" }
        } }
      }
    } }
  },
  "$defs": { "consequence": { "type": "object", "required": ["state", "text"], "properties": {
    "state": { "enum": ["BLOCKED", "ADVISORY", "SATISFIED", "UNKNOWN"] },
    "text": { "type": "string" }
  } } }
}
